Cell[BoxData[
 RowBox[{
  RowBox[{"I11231", "[", 
   RowBox[{"p_", ",", "x_", ",", "lEH_", ",", "xstar_"}], "]"}], ":=", 
  RowBox[{"Evaluate", "@", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Expand", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"x", "^", "2"}], "-", "1"}], ")"}], "*", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ARSimpI11", "[", 
            RowBox[{
             RowBox[{"1", "-", "p"}], ",", "x", ",", "lEH"}], "]"}], "-", 
           RowBox[{"ARSimpI11", "[", 
            RowBox[{
             RowBox[{"3", "-", "p"}], ",", "x", ",", "lEH"}], "]"}], "+", 
           RowBox[{"2", "*", 
            RowBox[{"AISimpI11", "[", 
             RowBox[{
              RowBox[{"2", "-", "p"}], ",", "x", ",", "lEH"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"p", ">", "0"}], "&&", 
           RowBox[{"x", ">", "0"}]}]}], "]"}]}], "+", 
       RowBox[{"2", "*", "x", "*", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AISimpI11", "[", 
            RowBox[{
             RowBox[{"1", "-", "p"}], ",", "x", ",", "lEH"}], "]"}], "-", 
           RowBox[{"AISimpI11", "[", 
            RowBox[{
             RowBox[{"3", "-", "p"}], ",", "x", ",", "lEH"}], "]"}], "-", 
           RowBox[{"2", "*", 
            RowBox[{"ARSimpI11", "[", 
             RowBox[{
              RowBox[{"2", "-", "p"}], ",", "x", ",", "lEH"}], "]"}]}]}], ",", 
          RowBox[{
           RowBox[{"p", ">", "0"}], "&&", 
           RowBox[{"x", ">", "0"}]}]}], "]"}]}]}], "]"}], ",", 
     RowBox[{"x", "^", "_"}], ",", "Simplify"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.819433145882938*^9, 3.819433203933957*^9}, {
