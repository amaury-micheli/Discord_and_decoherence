Cell[BoxData[
 RowBox[{
  RowBox[{"G22Deco", "[", 
   RowBox[{"p_", ",", "x_", ",", "lEH_", ",", "xstar_", ",", "kgam_"}], "]"}],
   ":=", 
  RowBox[{
   RowBox[{"G22", "[", "x", "]"}], "-", 
   RowBox[{"0.5", "*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"kgam", "/", "k0"}], ")"}], "^", "2"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"I22", "[", 
       RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar"}], "]"}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", "/", 
          RowBox[{"(", 
           RowBox[{"x", "^", "2"}], ")"}]}]}], ")"}], "*", 
       RowBox[{"I11", "[", 
        RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar"}], "]"}]}]}], ")"}], 
    "*", 
    RowBox[{"HeavisideTheta", "[", 
     RowBox[{"N0", "-", 
      RowBox[{"Log", "[", 
       RowBox[{"x", "/", "kphys0"}], "]"}], "-", "Ncrossref"}], 
     "]"}]}]}]}]], "Input",
