Cell[CellGroupData[{

Cell["\[Sigma] elegant version", "Section",
 CellChangeTimes->{{3.846692949360362*^9, 
  3.846692985533964*^9}},ExpressionUUID->"1722eabc-cb2f-4599-97d3-\
6fed891536ad"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "For", " ", "de", " ", "Sitter", " ", "the", " ", "integral", " ", "Lk", 
    " ", "is", " ", "evaluated", " ", "exactly"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Lk", "[", 
    RowBox[{"p_", ",", "x_", ",", "lEH_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"x", "^", 
      RowBox[{"(", 
       RowBox[{"4", "-", "p"}], ")"}]}], 
     RowBox[{"p", "-", "4"}]], "+", 
    FractionBox[
     RowBox[{"x", "^", 
      RowBox[{"(", 
       RowBox[{"2", "-", "p"}], ")"}]}], 
     RowBox[{"p", "-", "2"}]], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"(", "lEH", ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"p", "-", "4"}], ")"}]}], 
     RowBox[{"p", "-", "4"}]], "-", 
    FractionBox[
     RowBox[{
      RowBox[{"(", "lEH", ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"p", "-", "2"}], ")"}]}], 
     RowBox[{"p", "-", "2"}]]}]}]}]], "Input",
 CellChangeTimes->{{3.840618277338784*^9, 3.840618337122355*^9}, {
  3.840618451475402*^9, 3.840618539420651*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"00a2e4fa-5211-42c9-aec7-953d8cb29ee6"],

Cell[BoxData[
 RowBox[{
