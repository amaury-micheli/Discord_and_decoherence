Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Expression", " ", "without", " ", "difference", " ", "with", " ", "the", 
    " ", "decoherence", " ", "term", " ", 
    RowBox[{"expanded", ".", " ", "This"}], " ", "does", " ", "not", " ", 
    "cause", " ", "numerical", " ", 
    RowBox[{"problem", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Sigma2ElegantTheta", "[", 
    RowBox[{
    "p_", ",", "x_", ",", "lEH_", ",", "xstar_", ",", "kgam_", ",", 
     "\[Theta]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Evaluate", "@", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", "*", "\[Theta]"}], "]"}]}], "^", "2"}], "*", 
     RowBox[{"Sigma2Elegant", "[", 
      RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar", ",", "kgam"}], "]"}]}],
     "+", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"2", "*", "\[Theta]"}], "]"}], "^", "2"}], "*", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"G11Deco", "[", 
          RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar", ",", "kgam"}], 
          "]"}], "+", 
         RowBox[{"G22Deco", "[", 
          RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar", ",", "kgam"}], 
          "]"}]}], ")"}], "^", "2"}], "/", "4"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.846692994224947*^9, 3.8466929945526342`*^9}, {
  3.846824776612163*^9, 3.8468247993291073`*^9}, {3.846825189601079*^9, 
  3.8468252101261663`*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"fdd108a7-3ecc-439a-8642-662ebe752d8f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Discord", "Section",
 CellChangeTimes->{{3.819607347126306*^9, 
  3.819607354841824*^9}},ExpressionUUID->"9125c92e-649f-42fd-a2a7-\
e7895571a094"],

Cell["Function necessary to compute the Discord", "Text",
 CellChangeTimes->{{3.8468247003264847`*^9, 
  3.846824711788652*^9}},ExpressionUUID->"13d2a74c-5c5b-4873-a6d7-\
9d538da0af38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"x", "\[LessEqual]", "1"}], ",", "0", ",", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"x", "<", "1000"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "+", "1"}], ")"}], "*", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "+", "1"}], ")"}], "/", "2"}], "]"}], "/", 
          RowBox[{"Log", "[", "2", "]"}]}], "/", "2"}]}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "1"}], ")"}], "*", 
        RowBox[{
         RowBox[{
          RowBox[{"Log", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "1"}], ")"}], "/", "2"}], "]"}], "/", 
          RowBox[{"Log", "[", "2", "]"}]}], "/", "2"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"x", "/", "2"}], "]"}], "/", 
        RowBox[{"Log", "[", "2", "]"}]}], "+", 
       RowBox[{"1", "/", 
        RowBox[{"Log", "[", "2", "]"}]}]}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8196073556791897`*^9, 3.819607419554575*^9}, {
  3.819607461047333*^9, 3.819607508614958*^9}, {3.819612456035679*^9, 
  3.819612469608303*^9}},
 CellLabel->"In[82]:=",ExpressionUUID->"f140d798-7e3a-4b4d-a13d-f20f26aef7c9"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
  "We", " ", "compare", " ", "an", " ", "approximation", " ", "of", " ", 
   "the", " ", "discord", " ", "by", " ", "its", " ", "dominant", " ", "term",
    " ", "to", " ", "compare", " ", "it", " ", "with", " ", "the", " ", 
   "value", " ", "obtained", " ", "using", " ", "the", " ", "full", " ", 
   "sigma", " ", "modified", " ", "containing", " ", "several", " ", 
   "terms"}], "*)"}]], "Input",
 CellChangeTimes->{{3.8196073556791897`*^9, 3.819607419554575*^9}, {
  3.819607461047333*^9, 
  3.819607508614958*^9}},ExpressionUUID->"aa3bb015-914a-4ffb-a9ab-\
eb8463403742"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]22", "[", 
     RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar"}], "]"}], "+", 
    RowBox[{"\[Mu]22", "[", 
     RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar"}], "]"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"2", "/", 
        RowBox[{"x", "^", "2"}]}]}], ")"}], "*", 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{"\[Lambda]11", "[", 
        RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar"}], "]"}], "+", 
       RowBox[{"\[Mu]11", "[", 
        RowBox[{"p", ",", "x", ",", "lEH", ",", "xstar"}], "]"}]}], ")"}]}]}],
    ",", 
   RowBox[{"x", "^", "_"}], ",", "Simplify"}], "]"}]], "Input",
 CellChangeTimes->{{3.819607607948276*^9, 3.819607722150985*^9}, {
  3.8196479214159813`*^9, 3.8196479217483997`*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"fb0f8850-a158-449a-bb11-81029be0d475"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"26", "-", 
       RowBox[{"11", " ", "p"}], "+", 
       SuperscriptBox["p", "2"]}], ")"}], " ", 
     SuperscriptBox["x", 
      RowBox[{"4", "-", "p"}]], " ", 
     SuperscriptBox["xstar", 
      RowBox[{
       RowBox[{"-", "3"}], "+", "p"}]]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "8"}], "+", "p"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "5"}], "+", "p"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", "p"}], ")"}]}]]}], "+", 
  FractionBox[
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "344"}], "+", 
      RowBox[{"146", " ", "p"}], "-", 
      RowBox[{"21", " ", 
       SuperscriptBox["p", "2"]}], "+", 
      SuperscriptBox["p", "3"]}], ")"}], " ", 
    SuperscriptBox["x", 
     RowBox[{"6", "-", "p"}]], " ", 
    SuperscriptBox["xstar", 
     RowBox[{
      RowBox[{"-", "3"}], "+", "p"}]]}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "10"}], "+", "p"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "8"}], "+", "p"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "7"}], "+", "p"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "5"}], "+", "p"}], ")"}], " ", 
