Cell[CellGroupData[{

Cell["\[Gamma] with decoherence in de Sitter", "Section",
 CellChangeTimes->{{3.8466423108086967`*^9, 
  3.846642326998608*^9}},ExpressionUUID->"07a216eb-94ae-41f4-b2bd-\
451d506994a8"],

Cell[CellGroupData[{

Cell["\<\
Computation of the integral appearing in the decoherence term\
\>", "Subsubsection",
 CellChangeTimes->{{3.846642328417424*^9, 3.846642336599431*^9}, 
   3.84664243725467*^9, {3.847561203176464*^9, 
   3.847561263941431*^9}},ExpressionUUID->"0717b326-1886-47df-98b4-\
b80d06fe3edc"],

Cell["The integral is", "Text",
 CellChangeTimes->{{3.847561269391635*^9, 
  3.8475612775795603`*^9}},ExpressionUUID->"47012fd2-4f8a-4928-8c5a-\
49ee829f4cd3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"ComplexExpand", "[", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"2", "*", "I", "*", "y"}], "]"}], "*", 
       RowBox[{"y", "^", 
        RowBox[{"(", "\[Alpha]", ")"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", 
        RowBox[{"1", "/", "lEH"}], ",", "x"}], "}"}]}], "]"}], "]"}], ",", 
   RowBox[{
    RowBox[{"lEH", ">", "0"}], "&&", 
    RowBox[{"\[Alpha]", ">", "0"}], "&&", 
    RowBox[{"x", ">", "0"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.840595962902265*^9, 3.840596027828916*^9}, {
  3.8405961755194798`*^9, 3.840596210296802*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"4e0c3414-8d51-46dc-8625-af2a9a249376"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SuperscriptBox["lEH", 
    RowBox[{
     RowBox[{"-", "1"}], "-", "\[Alpha]"}]], " ", 
   RowBox[{"ExpIntegralE", "[", 
    RowBox[{
     RowBox[{"-", "\[Alpha]"}], ",", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", "\[ImaginaryI]"}], "lEH"]}]}], "]"}]}], "-", 
  RowBox[{
   SuperscriptBox["x", 
    RowBox[{"1", "+", "\[Alpha]"}]], " ", 
   RowBox[{"ExpIntegralE", "[", 
    RowBox[{
     RowBox[{"-", "\[Alpha]"}], ",", 
     RowBox[{
      RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "x"}]}], 
    "]"}]}]}]], "Output",
 CellChangeTimes->{3.84059605393786*^9, 3.8405962371816483`*^9, 
  3.8466424057926083`*^9},
 CellLabel->"Out[23]=",ExpressionUUID->"a3157d4c-865c-4611-8638-c1da22f404f0"]
}, Open  ]],

Cell["The above can be recasted in", "Text",
 CellChangeTimes->{{3.846642493054233*^9, 
  3.846642512969076*^9}},ExpressionUUID->"2ea78373-33b0-4dcf-9c45-\
a2d7741161ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{"A", "[", 
   RowBox[{"\[Alpha]_", ",", "x_", ",", "lEH_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "*", "I"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{"1", "+", "\[Alpha]"}], ")"}]}]}], "*", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"1", "+", "\[Alpha]"}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], "*", 
        RowBox[{"I", "/", "lEH"}]}]}], "]"}], "-", 
     RowBox[{"Gamma", "[", 
      RowBox[{
       RowBox[{"1", "+", "\[Alpha]"}], ",", 
       RowBox[{
        RowBox[{"-", "2"}], "*", "I", "*", "x"}]}], "]"}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.815714432990512*^9, 3.815714456207603*^9}, {
  3.816419756936707*^9, 3.81641976394759*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"04ae3272-2c8a-41d3-94c2-b12b7644d5b2"],

Cell["We want to expand for small values of x", "Text",
 CellChangeTimes->{{3.8466425195363827`*^9, 
  3.846642531064872*^9}},ExpressionUUID->"e502f4cd-19b6-41cc-9cfb-\
3ee196dd9a92"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"Re", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{"Normal", "[", 
      RowBox[{"Series", "[", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"\[Alpha]", ",", "x", ",", "lEH"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"lEH", ",", "0", ",", "1"}], "}"}]}], "]"}], "]"}], "]"}], 
    "]"}], ",", 
   RowBox[{
    RowBox[{"lEH", ">", "0"}], "&&", 
    RowBox[{"\[Alpha]", ">", "0"}], "&&", 
    RowBox[{"x", ">", "0"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.815714462831233*^9, 3.815714473758501*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"b8293906-2dd7-43c9-a6f4-6539cfbaab0b"],

Cell[BoxData["$Aborted"], "Output",
 CellChangeTimes->{{3.81571446527565*^9, 3.8157144823539953`*^9}, 
   3.81581811618108*^9, 3.815988125259643*^9, 3.818929096382207*^9, 
   3.819014415744905*^9, 3.819098716879313*^9, 3.819358855228586*^9, 
   3.8194420823113117`*^9, 3.819515226494562*^9, 3.840596923154442*^9, 
   3.846683969778317*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"c225509a-7ddc-4069-a637-9ac0fb8a7d38"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "simplification", " ", "is", " ", "better", " ", "performed", 
    " ", "term", " ", "by", " ", 
    RowBox[{"term", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"ComplexExpand", "[", 
      RowBox[{"Normal", "[", 
       RowBox[{"Series", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "2"}], "*", "I"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"-", 
              RowBox[{"(", 
               RowBox[{"1", "+", "\[Alpha]"}], ")"}]}], ")"}]}]}], "*", 
          RowBox[{"Gamma", "[", 
           RowBox[{
            RowBox[{"1", "+", "\[Alpha]"}], ",", 
            RowBox[{
             RowBox[{"-", "2"}], "*", "I", "*", "x"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "11"}], "}"}]}], "]"}], "]"}], "]"}], 
     "]"}], ",", 
    RowBox[{
     RowBox[{"\[Alpha]", ">", "0"}], "&&", 
     RowBox[{"x", ">", "0"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.81571338487527*^9, 3.81571339059365*^9}, {
   3.8157134330287046`*^9, 3.815713475965597*^9}, {3.815713509887538*^9, 
   3.815713518460775*^9}, {3.815713605975527*^9, 3.8157136247020197`*^9}, {
   3.81571366043417*^9, 3.815713663233553*^9}, {3.815713720002212*^9, 
   3.815713727005649*^9}, 3.815714215347488*^9, {3.815714264334906*^9, 
   3.8157142934723454`*^9}, {3.815714611565967*^9, 3.8157146235651217`*^9}, {
   3.816090184568914*^9, 3.816090185143415*^9}, 3.846648932719515*^9, {
   3.846649143190352*^9, 3.8466491437605467`*^9}, 3.846649309875196*^9},
 CellLabel->
  "In[190]:=",ExpressionUUID->"f26d13ae-ce62-4293-bb08-5b818959c0de"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["x", 
     RowBox[{"1", "+", "\[Alpha]"}]], " ", 
    RowBox[{"(", 
     RowBox[{
      FractionBox["14175", 
       RowBox[{"1", "+", "\[Alpha]"}]], "-", 
