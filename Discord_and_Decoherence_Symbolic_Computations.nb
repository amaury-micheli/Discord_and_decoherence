  RowBox[{"G11Deco", "[", 
   RowBox[{"p_", ",", "x_", ",", "lEH_", ",", "xstar_", ",", "kgam_"}], "]"}],
   ":=", 
  RowBox[{
   RowBox[{"G11", "[", "x", "]"}], "-", 
